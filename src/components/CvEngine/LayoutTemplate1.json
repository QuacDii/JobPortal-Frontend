{
  "type": "Container",
  "styles": {
    "boxSizing": "border-box",
    "width": "210mm",
    "minHeight": "297mm",
    "display": "flex",
    "flexDirection": "row",
    "backgroundColor": "#ffffff",
    "fontFamily": "var(--font-family, Arial, sans-serif)",
    "lineHeight": "var(--line-height, 1.5)",
    "fontSize": "var(--base-font-size, 13px)",
    "overflow": "hidden"
  },
  "children": [
    {
      "type": "Container",
      "styles": {
        "width": "35%",
        "backgroundColor": "var(--theme-color, #574040)",
        "color": "#ffffff",
        "display": "flex",
        "flexDirection": "column",
        "--heading-bg": "var(--theme-color, #574040)",
        "--heading-line": "var(--theme-color, #574040)",
        "--line-opacity": "0.4"
      },
      "children": [
        {
          "type": "Container",
          "id": "section-avatar-profile",
          "styles": {
            "padding": "35px 25px 25px",
            "display": "flex",
            "flexDirection": "column",
            "alignItems": "center",
            "backgroundColor": "transparent"
          },
          "children": [
            { "type": "Image", "dataPath": "personalInfo.avatar", "styles": { "width": "160px", "height": "160px", "objectFit": "cover", "borderRadius": "50%", "border": "10px solid #574040", "marginBottom": "20px" } },
            { "type": "Text", "dataPath": "personalInfo.fullName", "placeholder": "HỌ TÊN", "styles": { "fontSize": "22px", "fontWeight": "bold", "textAlign": "center", "marginBottom": "5px", "textTransform": "uppercase", "display": "block", "width": "100%" } },
            { "type": "Text", "dataPath": "personalInfo.jobTitle", "placeholder": "Vị trí ứng tuyển", "styles": { "fontSize": "15px", "textAlign": "center", "opacity": "0.9", "display": "block", "width": "100%" } }
          ]
        },
        {
          "type": "Container",
          "id": "left-col",
          "styles": {
            "padding": "25px 25px 35px",
            "backgroundColor": "rgba(0, 0, 0, 0.30)",
            "flexGrow": "1",
            "display": "flex",
            "flexDirection": "column",
            "gap": "25px"
          },
          "children": [
            {
              "type": "Container",
              "id": "section-contact-info",
              "styles": { "width": "100%", "display": "flex", "flexDirection": "column", "gap": "14px" },
              "children": [
                {
                  "type": "Container",
                  "id": "section-contact-phone",
                  "styles": { "display": "flex", "gap": "12px", "alignItems": "center", "width": "100%" },
                  "children": [
                    { "type": "Icon", "name": "phone", "styles": { "opacity": "0.85", "fontSize": "13px" } },
                    { "type": "Text", "dataPath": "personalInfo.phone", "placeholder": "0123 456 789", "styles": { "fontSize": "12px" } }
                  ]
                },
                {
                  "type": "Container",
                  "id": "section-contact-dob",
                  "styles": { "display": "flex", "gap": "12px", "alignItems": "center", "width": "100%" },
                  "children": [
                    { "type": "Icon", "name": "calendar", "styles": { "opacity": "0.85", "fontSize": "13px" } },
                    { "type": "Text", "dataPath": "personalInfo.dob", "placeholder": "Ngày sinh", "styles": { "fontSize": "12px" } }
                  ]
                },
                {
                  "type": "Container",
                  "id": "section-contact-email",
                  "styles": { "display": "flex", "gap": "12px", "alignItems": "center", "width": "100%" },
                  "children": [
                    { "type": "Icon", "name": "mail", "styles": { "opacity": "0.85", "fontSize": "13px" } },
                    { "type": "Text", "dataPath": "personalInfo.email", "placeholder": "jobsnow@gmail.com", "styles": { "fontSize": "12px", "wordBreak": "break-all" } }
                  ]
                },
                {
                  "type": "Container",
                  "id": "section-contact-website",
                  "styles": { "display": "flex", "gap": "12px", "alignItems": "center", "width": "100%" },
                  "children": [
                    { "type": "Icon", "name": "website", "styles": { "opacity": "0.85", "fontSize": "13px" } },
                    { "type": "Text", "dataPath": "personalInfo.website", "placeholder": "facebook.com/JobsNow.vn", "styles": { "fontSize": "12px" } }
                  ]
                },
                {
                  "type": "Container",
                  "id": "section-contact-address",
                  "styles": { "display": "flex", "gap": "12px", "alignItems": "center", "width": "100%" },
                  "children": [
                    { "type": "Icon", "name": "address", "styles": { "opacity": "0.85", "fontSize": "13px" } },
                    { "type": "Text", "dataPath": "personalInfo.address", "placeholder": "STU, TP HCM", "styles": { "fontSize": "12px" } }
                  ]
                }
              ]
            },
            {
              "type": "Container",
              "id": "section-education",
              "styles": { "width": "100%" },
              "children": [
                {
                  "type": "Container",
                  "styles": { "display": "flex", "alignItems": "center", "marginBottom": "15px", "width": "100%" },
                  "children": [
                    { "type": "Text", "content": "Học vấn", "styles": { "backgroundColor": "var(--heading-bg)", "color": "#ffffff", "padding": "6px 18px", "borderRadius": "20px", "fontWeight": "bold", "fontSize": "14px", "whiteSpace": "nowrap" } },
                    { "type": "Container", "styles": { "flexGrow": "1", "height": "1px", "backgroundColor": "var(--heading-line)", "marginLeft": "15px", "opacity": "var(--line-opacity)" } }
                  ]
                },
                {
                  "type": "LoopContainer",
                  "dataPath": "education",
                  "styles": { "display": "flex", "flexDirection": "column", "gap": "15px", "width": "100%" },
                  "itemTemplate": {
                    "type": "Container",
                    "children": [
                      { "type": "Text", "dataPath": "major", "placeholder": "Ngành học / Môn học", "styles": { "fontWeight": "bold", "fontSize": "13px", "display": "block", "width": "100%" } },
                      { "type": "Container", "styles": { "display": "inline-flex", "width": "fit-content", "alignItems": "center", "gap": "4px", "fontSize": "12px", "marginBottom": "4px", "opacity": "0.9", "whiteSpace": "nowrap" }, "children": [ { "type": "Text", "dataPath": "startDate", "placeholder": "Bắt đầu" }, { "type": "Text", "content": " - " }, { "type": "Text", "dataPath": "endDate", "placeholder": "Kết thúc" } ] },
                      { "type": "Text", "dataPath": "school", "placeholder": "Tên trường học", "styles": { "fontWeight": "bold", "fontSize": "13px", "display": "block", "width": "100%", "marginBottom": "4px" } },
                      { "type": "RichText", "dataPath": "description", "placeholder": "Mô tả quá trình học tập...", "styles": { "fontSize": "12px", "border": "none", "outline": "none" } }
                    ]
                  }
                }
              ]
            },
            {
              "type": "Container",
              "id": "section-skills",
              "styles": { "width": "100%" },
              "children": [
                {
                  "type": "Container",
                  "styles": { "display": "flex", "alignItems": "center", "marginBottom": "15px", "width": "100%" },
                  "children": [
                    { "type": "Text", "content": "Kỹ năng", "styles": { "backgroundColor": "var(--heading-bg)", "color": "#ffffff", "padding": "6px 18px", "borderRadius": "20px", "fontWeight": "bold", "fontSize": "14px", "whiteSpace": "nowrap" } },
                    { "type": "Container", "styles": { "flexGrow": "1", "height": "1px", "backgroundColor": "var(--heading-line)", "marginLeft": "15px", "opacity": "var(--line-opacity)" } }
                  ]
                },
                {
                  "type": "LoopContainer",
                  "dataPath": "skills",
                  "styles": { "display": "flex", "flexDirection": "column", "gap": "10px", "width": "100%" },
                  "itemTemplate": { "type": "Text", "dataPath": "name", "placeholder": "Tên kỹ năng", "styles": { "fontSize": "12px", "display": "block", "width": "100%" } }
                }
              ]
            },
            {
              "type": "Container",
              "id": "section-hobbies",
              "styles": { "width": "100%" },
              "children": [
                {
                  "type": "Container",
                  "styles": { "display": "flex", "alignItems": "center", "marginBottom": "15px", "width": "100%" },
                  "children": [
                    { "type": "Text", "content": "Sở thích", "styles": { "backgroundColor": "var(--heading-bg)", "color": "#ffffff", "padding": "6px 18px", "borderRadius": "20px", "fontWeight": "bold", "fontSize": "14px", "whiteSpace": "nowrap" } },
                    { "type": "Container", "styles": { "flexGrow": "1", "height": "1px", "backgroundColor": "var(--heading-line)", "marginLeft": "15px", "opacity": "var(--line-opacity)" } }
                  ]
                },
                {
                  "type": "LoopContainer",
                  "dataPath": "hobbies",
                  "styles": { "display": "flex", "flexDirection": "column", "gap": "10px", "width": "100%" },
                  "itemTemplate": { "type": "Text", "dataPath": "name", "placeholder": "Tên sở thích", "styles": { "fontSize": "12px", "display": "block", "width": "100%" } }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "id": "right-col",
      "styles": {
        "width": "65%",
        "padding": "35px 40px",
        "backgroundColor": "#ffffff",
        "color": "#333333",
        "display": "flex",
        "flexDirection": "column",
        "gap": "30px",
        "--heading-bg": "var(--theme-color, #574040)",
        "--heading-line": "var(--theme-color, #574040)",
        "--line-opacity": "0.3"
      },
      "children": [
        {
          "type": "Container",
          "id": "section-summary",
          "styles": {},
          "children": [
            {
              "type": "Container",
              "styles": { "display": "flex", "alignItems": "center", "marginBottom": "15px" },
              "children": [
                { "type": "Text", "content": "Mục tiêu nghề nghiệp", "styles": { "backgroundColor": "var(--heading-bg)", "color": "#ffffff", "padding": "6px 18px", "borderRadius": "20px", "fontWeight": "bold", "fontSize": "14px", "whiteSpace": "nowrap" } },
                { "type": "Container", "styles": { "flexGrow": "1", "height": "1px", "backgroundColor": "var(--heading-line)", "marginLeft": "15px", "opacity": "var(--line-opacity)" } }
              ]
            },
            { "type": "RichText", "dataPath": "summary", "placeholder": "Mục tiêu nghề nghiệp của bạn, bao gồm mục tiêu ngắn hạn và dài hạn...", "styles": { "textAlign": "justify", "fontSize": "13px", "border": "none", "outline": "none" } }
          ]
        },
        {
          "type": "Container",
          "id": "section-experience",
          "styles": {},
          "children": [
            {
              "type": "Container",
              "styles": { "display": "flex", "alignItems": "center", "marginBottom": "20px" },
              "children": [
                { "type": "Text", "content": "Kinh nghiệm làm việc", "styles": { "backgroundColor": "var(--heading-bg)", "color": "#ffffff", "padding": "6px 18px", "borderRadius": "20px", "fontWeight": "bold", "fontSize": "14px", "whiteSpace": "nowrap" } },
                { "type": "Container", "styles": { "flexGrow": "1", "height": "1px", "backgroundColor": "var(--heading-line)", "marginLeft": "15px", "opacity": "var(--line-opacity)" } }
              ]
            },
            {
              "type": "LoopContainer",
              "dataPath": "experience",
              "styles": { "display": "flex", "flexDirection": "column", "gap": "20px" },
              "itemTemplate": {
                "type": "Container",
                "children": [
                  {
                    "type": "Container",
                    "styles": { "display": "flex", "justifyContent": "space-between", "alignItems": "center", "marginBottom": "4px" },
                    "children": [
                      { "type": "Text", "dataPath": "title", "placeholder": "Vị trí công việc", "styles": { "fontWeight": "bold", "fontSize": "14px" } },
                      { "type": "Container", "styles": { "display": "flex", "gap": "4px", "fontWeight": "bold", "fontSize": "13px", "whiteSpace": "nowrap", "flexShrink": "0", "alignItems": "center" }, "children": [ { "type": "Text", "dataPath": "startDate", "placeholder": "Bắt đầu" }, { "type": "Text", "content": " - " }, { "type": "Text", "dataPath": "endDate", "placeholder": "Kết thúc" } ] }
                    ]
                  },
                  { "type": "Text", "dataPath": "companyName", "placeholder": "Tên công ty", "styles": { "marginBottom": "8px", "fontSize": "13px", "fontStyle": "italic" } },
                  { "type": "RichText", "dataPath": "description", "placeholder": "Mô tả công việc...", "styles": { "fontSize": "13px", "border": "none", "outline": "none" } }
                ]
              }
            }
          ]
        },
        {
          "type": "Container",
          "id": "section-awards",
          "styles": {},
          "children": [
            {
              "type": "Container",
              "styles": { "display": "flex", "alignItems": "center", "marginBottom": "20px" },
              "children": [
                { "type": "Text", "content": "Danh hiệu và giải thưởng", "styles": { "backgroundColor": "var(--heading-bg)", "color": "#ffffff", "padding": "6px 18px", "borderRadius": "20px", "fontWeight": "bold", "fontSize": "14px", "whiteSpace": "nowrap" } },
                { "type": "Container", "styles": { "flexGrow": "1", "height": "1px", "backgroundColor": "var(--heading-line)", "marginLeft": "15px", "opacity": "var(--line-opacity)" } }
              ]
            },
            {
              "type": "LoopContainer",
              "dataPath": "awards",
              "styles": { "display": "flex", "flexDirection": "column", "gap": "10px" },
              "itemTemplate": { "type": "Container", "styles": { "display": "flex", "alignItems": "center", "gap": "15px" }, "children": [ { "type": "Text", "dataPath": "time", "placeholder": "Thời gian", "styles": { "fontWeight": "bold", "whiteSpace": "nowrap", "flexShrink": "0" } }, { "type": "Text", "dataPath": "name", "placeholder": "Tên giải thưởng", "styles": { "flexGrow": "1" } } ] }
            }
          ]
        },
        {
          "type": "Container",
          "id": "section-certificates",
          "styles": {},
          "children": [
            {
              "type": "Container",
              "styles": { "display": "flex", "alignItems": "center", "marginBottom": "20px" },
              "children": [
                { "type": "Text", "content": "Chứng chỉ", "styles": { "backgroundColor": "var(--heading-bg)", "color": "#ffffff", "padding": "6px 18px", "borderRadius": "20px", "fontWeight": "bold", "fontSize": "14px", "whiteSpace": "nowrap" } },
                { "type": "Container", "styles": { "flexGrow": "1", "height": "1px", "backgroundColor": "var(--heading-line)", "marginLeft": "15px", "opacity": "var(--line-opacity)" } }
              ]
            },
            {
              "type": "LoopContainer",
              "dataPath": "certificates",
              "styles": { "display": "flex", "flexDirection": "column", "gap": "10px" },
              "itemTemplate": { "type": "Container", "styles": { "display": "flex", "alignItems": "center", "gap": "15px" }, "children": [ { "type": "Text", "dataPath": "time", "placeholder": "Thời gian", "styles": { "fontWeight": "bold", "whiteSpace": "nowrap", "flexShrink": "0" } }, { "type": "Text", "dataPath": "name", "placeholder": "Tên chứng chỉ", "styles": { "flexGrow": "1" } } ] }
            }
          ]
        },
        {
          "type": "Container",
          "id": "section-activities",
          "styles": {},
          "children": [
            {
              "type": "Container",
              "styles": { "display": "flex", "alignItems": "center", "marginBottom": "20px" },
              "children": [
                { "type": "Text", "content": "Hoạt động", "styles": { "backgroundColor": "var(--heading-bg)", "color": "#ffffff", "padding": "6px 18px", "borderRadius": "20px", "fontWeight": "bold", "fontSize": "14px", "whiteSpace": "nowrap" } },
                { "type": "Container", "styles": { "flexGrow": "1", "height": "1px", "backgroundColor": "var(--heading-line)", "marginLeft": "15px", "opacity": "var(--line, 0.3)" } }
              ]
            },
            {
              "type": "LoopContainer",
              "dataPath": "activities",
              "styles": { "display": "flex", "flexDirection": "column", "gap": "20px" },
              "itemTemplate": {
                "type": "Container",
                "children": [
                  {
                    "type": "Container",
                    "styles": { "display": "flex", "justifyContent": "space-between", "alignItems": "center", "marginBottom": "4px" },
                    "children": [
                      { "type": "Text", "dataPath": "role", "placeholder": "Vị trí của bạn", "styles": { "fontWeight": "bold", "fontSize": "14px" } },
                      { "type": "Container", "styles": { "display": "flex", "gap": "4px", "fontWeight": "bold", "fontSize": "13px", "whiteSpace": "nowrap", "flexShrink": "0", "alignItems": "center" }, "children": [ { "type": "Text", "dataPath": "startDate", "placeholder": "Bắt đầu" }, { "type": "Text", "content": " - " }, { "type": "Text", "dataPath": "endDate", "placeholder": "Kết thúc" } ] }
                    ]
                  },
                  { "type": "Text", "dataPath": "organization", "placeholder": "Tên tổ chức", "styles": { "marginBottom": "8px", "fontSize": "13px", "fontStyle": "italic" } },
                  { "type": "RichText", "dataPath": "description", "placeholder": "Mô tả hoạt động...", "styles": { "fontSize": "13px", "border": "none", "outline": "none" } }
                ]
              }
            }
          ]
        },
        {
          "type": "Container",
          "id": "section-projects",
          "styles": {},
          "children": [
            {
              "type": "Container",
              "styles": { "display": "flex", "alignItems": "center", "marginBottom": "20px" },
              "children": [
                { "type": "Text", "content": "Dự án", "styles": { "backgroundColor": "var(--heading-bg)", "color": "#ffffff", "padding": "6px 18px", "borderRadius": "20px", "fontWeight": "bold", "fontSize": "14px", "whiteSpace": "nowrap" } },
                { "type": "Container", "styles": { "flexGrow": "1", "height": "1px", "backgroundColor": "var(--heading-line)", "marginLeft": "15px", "opacity": "var(--line-opacity)" } }
              ]
            },
            {
              "type": "LoopContainer",
              "dataPath": "projects",
              "styles": { "display": "flex", "flexDirection": "column", "gap": "20px" },
              "itemTemplate": {
                "type": "Container",
                "children": [
                  {
                    "type": "Container",
                    "styles": { "display": "flex", "justifyContent": "space-between", "alignItems": "center", "marginBottom": "4px" },
                    "children": [
                      { "type": "Text", "dataPath": "role", "placeholder": "Vị trí của bạn trong dự án", "styles": { "fontWeight": "bold", "fontSize": "14px" } },
                      { "type": "Container", "styles": { "display": "flex", "gap": "4px", "fontWeight": "bold", "fontSize": "13px", "whiteSpace": "nowrap", "flexShrink": "0", "alignItems": "center" }, "children": [ { "type": "Text", "dataPath": "startDate", "placeholder": "Bắt đầu" }, { "type": "Text", "content": " - " }, { "type": "Text", "dataPath": "endDate", "placeholder": "Kết thúc" } ] }
                    ]
                  },
                  { "type": "Text", "dataPath": "projectName", "placeholder": "Tên dự án", "styles": { "marginBottom": "8px", "fontSize": "13px", "fontStyle": "italic" } },
                  { "type": "RichText", "dataPath": "description", "placeholder": "Mô tả ngắn gọn về dự án...", "styles": { "fontSize": "13px", "border": "none", "outline": "none" } }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}